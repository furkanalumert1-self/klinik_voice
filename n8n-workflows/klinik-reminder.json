{
  "name": "klinik-reminder",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "klinik-reminder",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [240, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false },
          "conditions": [
            {
              "leftValue": "={{ $json.type }}",
              "rightValue": "reminder",
              "operator": { "type": "string", "operation": "contains" }
            }
          ]
        }
      },
      "id": "is-reminder",
      "name": "Is Reminder?",
      "type": "n8n-nodes-base.if",
      "position": [460, 300]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Webhook').item.json.email }}",
        "subject": "Randevu Hatırlatması — {{ $('Webhook').item.json.clinicName }}",
        "emailFormat": "html",
        "html": "<p>Sayın <strong>{{ $('Webhook').item.json.patientName }}</strong>,</p><p>Randevunuzu hatırlatmak istedik:</p><ul><li><strong>Tarih/Saat:</strong> {{ $('Webhook').item.json.appointmentAt }}</li><li><strong>Doktor:</strong> {{ $('Webhook').item.json.doctorName }}</li><li><strong>Hizmet:</strong> {{ $('Webhook').item.json.service }}</li><li><strong>Adres:</strong> {{ $('Webhook').item.json.clinicAddress }}</li></ul><p>Gelemeyecekseniz lütfen bizi arayın: {{ $('Webhook').item.json.clinicPhone }}</p><p>İyi günler dileriz,<br>{{ $('Webhook').item.json.clinicName }}</p>",
        "options": {}
      },
      "id": "send-reminder-mail",
      "name": "Hatırlatma Maili",
      "type": "n8n-nodes-base.gmail",
      "position": [680, 220]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Webhook').item.json.email }}",
        "subject": "Randevunuz Onaylandı — {{ $('Webhook').item.json.clinicName }}",
        "emailFormat": "html",
        "html": "<p>Sayın <strong>{{ $('Webhook').item.json.patientName }}</strong>,</p><p>Randevunuz başarıyla oluşturuldu.</p><ul><li><strong>Tarih/Saat:</strong> {{ $('Webhook').item.json.appointmentAt }}</li><li><strong>Adres:</strong> {{ $('Webhook').item.json.clinicAddress }}</li></ul><p>İptal veya değişiklik için: {{ $('Webhook').item.json.clinicPhone }}</p><p>İyi günler dileriz,<br>{{ $('Webhook').item.json.clinicName }}</p>",
        "options": {}
      },
      "id": "send-confirmation-mail",
      "name": "Onay Maili",
      "type": "n8n-nodes-base.gmail",
      "position": [680, 380]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true }"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [900, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Is Reminder?", "type": "main", "index": 0 }]]
    },
    "Is Reminder?": {
      "main": [
        [{ "node": "Hatırlatma Maili", "type": "main", "index": 0 }],
        [{ "node": "Onay Maili", "type": "main", "index": 0 }]
      ]
    },
    "Hatırlatma Maili": {
      "main": [[{ "node": "Respond", "type": "main", "index": 0 }]]
    },
    "Onay Maili": {
      "main": [[{ "node": "Respond", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": {},
  "tags": ["klinik"]
}
