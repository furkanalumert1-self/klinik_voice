{
  "name": "klinik-review",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 11 * * *" }]
        }
      },
      "id": "cron-trigger",
      "name": "Her Gün 11:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT a.id, a.patient_name, a.phone, a.email, a.appointment_at, d.full_name as doctor_name FROM appointments a LEFT JOIN doctors d ON a.doctor_id = d.id WHERE a.status = 'tamamlandi' AND a.appointment_at <= NOW() - INTERVAL '2 days' AND a.review_requested_at IS NULL AND a.email IS NOT NULL LIMIT 50"
      },
      "id": "postgres-query",
      "name": "Tamamlanan Randevular",
      "type": "n8n-nodes-base.postgres",
      "position": [460, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split-batches",
      "name": "Her Kayıt İçin",
      "type": "n8n-nodes-base.splitInBatches",
      "position": [680, 300]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "Alumert Klinik — Değerlendirmenizi Bekliyoruz ⭐",
        "emailFormat": "html",
        "html": "<p>Sayın <strong>{{ $json.patient_name }}</strong>,</p><p>{{ $json.doctor_name }} ile randevunuzdan 2 gün geçti. Umarız iyisinizdir.</p><p>Hizmetimizi değerlendirirseniz çok seviniriz:</p><p><a href='{{ $env.CLINIC_GOOGLE_REVIEW_LINK }}'>⭐ Google'da Değerlendir</a></p><p>İyi günler,<br>Alumert Klinik</p>",
        "options": {}
      },
      "id": "send-review-mail",
      "name": "Review Maili Gönder",
      "type": "n8n-nodes-base.gmail",
      "position": [900, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE appointments SET review_requested_at = NOW() WHERE id = '{{ $('Her Kayıt İçin').item.json.id }}'"
      },
      "id": "update-review-sent",
      "name": "review_requested_at Güncelle",
      "type": "n8n-nodes-base.postgres",
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Her Gün 11:00": {
      "main": [[{ "node": "Tamamlanan Randevular", "type": "main", "index": 0 }]]
    },
    "Tamamlanan Randevular": {
      "main": [[{ "node": "Her Kayıt İçin", "type": "main", "index": 0 }]]
    },
    "Her Kayıt İçin": {
      "main": [[{ "node": "Review Maili Gönder", "type": "main", "index": 0 }]]
    },
    "Review Maili Gönder": {
      "main": [[{ "node": "review_requested_at Güncelle", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": {},
  "tags": ["klinik"]
}
